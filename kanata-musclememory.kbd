;; [How to Set Up Kanata on NixOS: A Step-by-Step
;; Guide](https://dev.to/shanu-kumawat/how-to-set-up-kanata-on-nixos-a-step-by-step-guide-1jkc)

(defcfg
   alias-to-trigger-on-load to-nomods
   process-unmapped-keys yes
   delegate-to-first-layer yes
   log-layer-changes no
   ;; For defchordsv2
   concurrent-tap-hold     yes
   allow-hardware-repeat   no

   ;; Must stay >= $tap-time (200). After any non-chord activation, chords
   ;; processing is skipped for this long, so the second press of a
   ;; tap-then-hold bypasses chordsv2 and reaches the key's own tap-hold with
   ;; its repress context intact -- that is what makes bksp repeat on ralt
   ;; work while ralt is also a chord participant. The cost is global: no
   ;; chord fires within 200 ms of another keystroke, so every chord here has
   ;; to be a deliberate gesture from a short pause, never mid-typing.
   chords-v2-min-idle      200
)

(defalias toggle-numpad
  (switch
    ;; If current base is base, switch to target layer
    ((base-layer numpad)) (layer-switch base) break

    ;; Otherwise, switch back to base
    () (layer-switch numpad) break
  )
)

(defchordsv2
  ;; Chord timeouts are deliberately short on every chord whose keys also
  ;; carry a tap-hold (esc, lalt, ralt, spc). When a chord does not complete
  ;; within its timeout the presses fall through to the active layer, so the
  ;; timeout is *added* to that key's own hold timeout: 80 + $hold-thumb
  ;; (290) = ~370 ms to reach a hold action. Raising it makes the chord
  ;; easier to hit but the hold sluggish; lowering it does the reverse.
  (esc 1) (layer-switch base) 80 all-released ()    ;; home row mods on
  (esc 2) (layer-switch nomods) 80 all-released ()  ;; home row mods off
  (lalt ralt) (layer-switch symb-flat) 80 all-released ()  ;; symbols layer
  (spc v) (layer-while-held system) 80 all-released ()     ;; system layer
  (spc m) (layer-while-held system) 80 all-released ()     ;; system layer

  ;; lmet is a one-shot rather than a tap-hold, so it has no hold timeout to
  ;; delay and can keep a comfortable window.
  (lmet rmet) (multi caps @tap) 500 all-released ()     ;; CapsLock
  (lmet prtsc) (multi caps @tap) 500 all-released ()    ;; CapsLock

  ;; v1.5.0: comma+period -> numpad layer (mirrors combo_numpad/TO(_L2)).
  ;; Disabled wherever , and . are already remapped to something else.
  ;; , and . are plain keys, so nothing to delay here either.
  (, .) (layer-switch numpad) 300 all-released (numpad fn navigation mouse system)

  ;; The v1.5.0 same-hand exceptions (hold D tap F -> Tab, hold K tap J ->
  ;; Down, mirroring chordal_hold.c) no longer need a chord entry here. They
  ;; could not keep one anyway -- they are meant to fire inside typing flow,
  ;; which is exactly what chords-v2-min-idle suppresses -- but the gestures
  ;; still work through the home row mods themselves: f is not in
  ;; $left-hand-keys, so holding d reaches the symb layer where @f2 taps tab;
  ;; j is not in $right-hand-keys, so holding k reaches symb where @j2 is
  ;; down. The chords only ever made that path fire sooner.
)

(defvar
  tap-time    200
  hold-thumb  290
  hold-index  200
  hold-middle 230
  hold-ring   260
  hold-pinky  290

  ;; This works only with an US keyboard layout.
  left-hand-keys (
    q w e r t
    z x c   b
  )

  right-hand-keys (
    y u i o p
    n   , . /
  )
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  ;; Temporary mod-disabling layer on tap
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  to-nomods (layer-switch nomods)

  ;; Home row for the base layer
  a (tap-hold-release-keys $tap-time $hold-pinky (multi a @tap) lsft $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-ring (multi s @tap) ralt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-middle (multi d @tap) (layer-while-held symb) $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-index (multi f @tap) lctl $left-hand-keys)
  g (tap-hold-release-keys $tap-time $hold-index (multi g @tap) lalt $left-hand-keys)
  v (tap-hold-release-keys $tap-time $hold-index (multi v @tap) rmet $left-hand-keys)
  ;;
  m (tap-hold-release-keys $tap-time $hold-index (multi m @tap) rmet $right-hand-keys)
  h (tap-hold-release-keys $tap-time $hold-index (multi h @tap) lalt $right-hand-keys)
  j (tap-hold-release-keys $tap-time $hold-index (multi j @tap) rctl $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-middle (multi k @tap) (layer-while-held symb) $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-ring (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time $hold-pinky (multi ; @tap) rsft $right-hand-keys)


  ;; Home row for the symb layer
  a2 (tap-hold-release-keys $tap-time $hold-pinky (multi esc @tap) lsft $left-hand-keys)
  s2 (tap-hold-release-keys $tap-time $hold-ring (multi ins @tap) ralt $left-hand-keys)
  d2 (tap-hold-release-keys $tap-time $hold-middle (multi del @tap) (layer-while-held symb) $left-hand-keys)
  f2 (tap-hold-release-keys $tap-time $hold-index (multi tab @tap) lctl $left-hand-keys)
  g2 (tap-hold-release-keys $tap-time $hold-index (multi bspc @tap) lalt $left-hand-keys)
  v2 (tap-hold-release-keys $tap-time $hold-index (multi [ @tap) rmet $left-hand-keys)
  ;;
  m2 (tap-hold-release-keys $tap-time $hold-index (multi ' @tap) rmet $right-hand-keys)
  h2 (tap-hold-release-keys $tap-time $hold-index (multi left @tap) lalt $right-hand-keys)
  j2 (tap-hold-release-keys $tap-time $hold-index (multi down @tap) rctl $right-hand-keys)
  k2 (tap-hold-release-keys $tap-time $hold-middle (multi up @tap) (layer-while-held symb) $right-hand-keys)
  l2 (tap-hold-release-keys $tap-time $hold-ring (multi right @tap) ralt $right-hand-keys)
  ;2 (tap-hold-release-keys $tap-time $hold-pinky (multi ret @tap) rsft $right-hand-keys)


  ;; Home row for the function layer
  a3 (tap-hold-release-keys $tap-time $hold-pinky (multi f11 @tap) lsft $left-hand-keys)
  s3 (tap-hold-release-keys $tap-time $hold-ring (multi f12 @tap) ralt $left-hand-keys)
  f3 (tap-hold-release-keys $tap-time $hold-index (multi f14 @tap) lctl $left-hand-keys)
  g3 (tap-hold-release-keys $tap-time $hold-index (multi f15 @tap) lalt $left-hand-keys)
  v3 (tap-hold-release-keys $tap-time $hold-index (multi f24 @tap) rmet $left-hand-keys)
  ;;
  m3 (tap-hold-release-keys $tap-time $hold-index (multi XX @tap) rmet $right-hand-keys)
  h3 (tap-hold-release-keys $tap-time $hold-index (multi f16 @tap) lalt $right-hand-keys)
  j3 (tap-hold-release-keys $tap-time $hold-index (multi f17 @tap) rctl $right-hand-keys)
  l3 (tap-hold-release-keys $tap-time $hold-ring (multi f19 @tap) ralt $right-hand-keys)
  ;3 (tap-hold-release-keys $tap-time $hold-pinky (multi f20 @tap) rsft $right-hand-keys)



  ;; Other keys
  ;; Access `lmet`, `lalt` and `ralt` on normal keyboards without using home row keys:
  esc (tap-hold $tap-time $hold-pinky esc lalt)
  ;; Navigation layer:
  tab (tap-hold $tap-time $hold-thumb tab (layer-while-held navigation))
  caps (tap-hold $tap-time $hold-pinky caps ralt)
  ;; Function layer:
  lmet (one-shot 2000 (layer-while-held fn))
  ;; Mouse layer:
  lalt (tap-hold $tap-time $hold-pinky  esc (layer-while-held mouse))
  lalt2 (tap-hold $tap-time $hold-pinky (layer-switch base) (layer-while-held mouse))
  ;; Symbol layer:
  spc (tap-hold $tap-time $hold-thumb  spc lmet)
  ;; Navigation layer:
  ;; tap -> bksp, tap then hold -> bksp key-repeat, hold -> navigation layer.
  ;; The repeat comes from the first parameter, the tap repress timeout: a
  ;; press+release+press within $tap-time holds the tap action instead of
  ;; resolving to the hold action, so the OS repeats bksp while held.
  ;; ralt is also a chordsv2 participant (lalt+ralt). That normally breaks
  ;; both of the above; the short chord timeout and chords-v2-min-idle in
  ;; defcfg are what keep them working. See the notes there.
  ralt (tap-hold $tap-time $hold-thumb bspc (layer-while-held navigation))
  ;; Layer switch on the Compose key
  comp (tap-dance 500 (comp  (multi @toggle-numpad)))
  comp2 (tap-dance 500 ((layer-switch base) (layer-switch numpad)))

  ;; System layer access from fn layer
  syst (layer-while-held system)

  ;; Number pad arithmetic tap-dance: tap=primary, hold=secondary, tap-then-hold=repeat primary
  kppl (tap-hold $tap-time $hold-thumb kp+ kp*)
  kpze (tap-hold $tap-time $hold-thumb kp0 NumpadEqual)
  kpmi (tap-hold $tap-time $hold-thumb kp- kp/)
  kpdo (tap-hold $tap-time $hold-thumb kp. kp,)

  ;; Mouse simulation
  mwu (mwheel-up 50 120)
  mwd (mwheel-down 50 120)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)

  ms↑ (movemouse-up 10 1)
  ms← (movemouse-left 10 1)
  ms↓ (movemouse-down 10 1)
  ms→ (movemouse-right 10 1)

)

(defsrc
    q w e r t   y u i o p
    a s d f g   h j k l ;
    z x c v b   n m , . /
    esc tab caps del lsft lmet lalt spc ralt rmet rsft prtsc
)

(deflayer base
   q  w  e  r  t    y  u  i  o  p
   @a @s @d @f @g   @h @j @k @l @;
   z  x  c  @v b    n  @m ,  .  /
   @esc @tab @caps del lsft @lmet @lalt @spc @ralt @comp rsft @comp
)

(deflayer symb
   1   2   3   4   5     6   7   8   9   0
   @a2 @s2 @d2 @f2 @g2   @h2 @j2 @k2 @l2 @;2
   `   -   =   @v2 ]     \   @m2 ,   .   /
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2
)

(deflayer symb-flat
   1    2   3   4   5     6    7    8  9     0
   esc  ins del tab bspc  left down up right ;
   `   -    =   [   ]     \    '    ,  .     /
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2
)

(deflayer numpad
    q w e r t        @kppl kp7 kp8 kp9 @kpze
    a s d f g        nlk   kp4 kp5 kp6 kprt
    z x c v b        @kpmi kp1 kp2 kp3 @kpdo
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2
)

(deflayer fn
   f1   f2 f3  f4  f5    f6  f7  f8  f9  f10
   @a3 @s3 f13 @f3 @g3   @h3 @j3 f18 @l3 @;3
   f21 f22 f23 @v3 XX    XX  @m3 XX  XX  @syst
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2
)

(deflayer navigation
   XX  XX  XX  XX  XX    home del  ins  end bspc
   @a2 @s2 @d2 @f2 @g2   @h2  @j2  @k2  @l2 @;2
   XX  XX  XX  XX  XX    XX  pgdn pgup XX  XX
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2
)

(deflayer mouse
   XX   XX   XX   XX   XX    XX   XX   XX   XX   XX
   mfwd mlft mmid mrgt mbck  @ms← @ms↓ @ms↑ @ms→ mlft
   XX   XX   XX   XX   XX    @mwl @mwd @mwu @mwr XX
   _ _ _ _ _ _ @lalt2 _ _ @comp2 _ @comp2

)
(deflayer system
   XX   XX XX XX XX     XX   brdn   bru  XX XX
   lrld XX XX XX XX     mute voldwn volu XX XX
   XX   XX XX XX XX     pp   prev   next XX XX
   XX   XX XX XX XX XX XX XX XX XX XX XX
)

(deflayer nomods
   q w e r t   y u i o p
   a s d f g   h j k l ;
   z x c v b   n m , . /
   esc tab caps del lsft lmet lalt spc ralt rmet rsft prtsc
)
